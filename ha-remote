log = logging.getLogger("ha-remote")

HOME = Path.home()
CONFIG_PATH = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "ha-remote" / "config.toml"
PROTOCOLS = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "ha-remote" / "protocols"
KBD_SAVE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "ha-remote-kbd"
SECRET_SERVICE = "ha-remote"
COOLDOWN_S = 5
STUCK_AFTER_S = 30
CONFIRM_WINDOW_S = 20
IDLE_AFTER_MS = 120_000
PROMPT_POLL_S = 1
RESEND_AFTER_S = 10
PROMPT_GONE_S = 3
EPOCH = "1970-01-01T00:00:00+00:00"

SCREEN = Path("/sys/class/backlight/apple-panel-bl")
KBD = Path("/sys/class/leds/kbd_backlight")
BATTERY = Path("/sys/class/power_supply/macsmc-battery")
AC = Path("/sys/class/power_supply/macsmc-ac")


def secret(key):
    proc = subprocess.run(["secret-tool", "lookup", "service", SECRET_SERVICE, "key", key],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        raise SystemExit(f"secret missing: secret-tool store --label='ha-remote {key}' service {SECRET_SERVICE} key {key}")
    return proc.stdout.rstrip("\n")


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=10)


def read(path, default=None):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default


def percent(device):
    cur, top = read(device / "brightness"), read(device / "max_brightness")
    return round(int(cur) * 100 / int(top)) if cur and top else None


def set_percent(device, pct):
    run("brightnessctl", "-d", device.name, "set", f"{max(0, min(100, pct))}%")


def password_not_typed(reason):
    log.warning("type_password: %s", reason)
    run("notify-send", "-e", "-u", "low", "-a", "M2 remote", "Password not typed", reason)


def noctalia_status():
    return json.loads(run("noctalia", "msg", "status").stdout)


def focused_app_id():
    out = run("niri", "msg", "--json", "focused-window").stdout.strip()
    window = json.loads(out) if out else None
    return window.get("app_id") if window else None


def cmdline(pid):
    return read(f"/proc/{pid}/cmdline", "").replace("\0", " ").strip()


def sudo_prompting():
    # Before authentication sudo has not forked the command yet.
    for pid in run("pgrep", "-x", "sudo").stdout.split():
        try:
            if not Path(f"/proc/{pid}/task/{pid}/children").read_text().strip():
                return int(pid)
        except OSError:
            pass
    return None


def stat(pid):
    try:
        fields = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()
        return int(fields[1]), int(fields[4])
    except (OSError, IndexError, ValueError):
        return 0, -1


def focus_window_of(pid):
    windows = {w.get("pid"): w["id"] for w in json.loads(run("niri", "msg", "--json", "windows").stdout)}
    _, tty = stat(pid)
    while pid > 1:
        if pid in windows:
            run("niri", "msg", "action", "focus-window", "--id", str(windows[pid]))
            time.sleep(0.3)
            return True
        ppid, ptty = stat(pid)
        # Only climb through the shell on the same tty; the terminal itself has none.
        if ptty != tty and ppid not in windows:
            return False
        pid = ppid
    return False


def kbd_off():
    # Save only once, or a second lock would save 0 and unlock would restore darkness.
    if not KBD_SAVE.exists():
        KBD_SAVE.write_text(read(KBD / "brightness", "0"))
    run("brightnessctl", "-d", KBD.name, "set", "0")


def kbd_restore():
    value = read(KBD_SAVE)
    if value is None:
        return
    KBD_SAVE.unlink(missing_ok=True)
    if value.isdigit():
        run("brightnessctl", "-d", KBD.name, "set", value)


def smc():
    out = {}
    for hwmon in glob.glob("/sys/class/hwmon/hwmon*"):
        if read(f"{hwmon}/name") != "macsmc_hwmon":
            continue
        for label in glob.glob(f"{hwmon}/*_label"):
            value = read(label.replace("_label", "_input"))
            if value is not None:
                out[read(label)] = int(value)
    return out


def system_power_w():
    value = smc().get("Total System Power")
    return None if value is None else round(value / 1e6)


class Idle(threading.Thread):
    def __init__(self, on_activity):
        super().__init__(daemon=True)
        self.idle = False
        self.on_activity = on_activity

    def run(self):
        try:
            sys.path.insert(0, str(PROTOCOLS))
            from pywayland.client import Display
            from hrproto.ext_idle_notify_v1 import ExtIdleNotifierV1
            from hrproto.wayland import WlSeat
            display = Display()
            display.connect()
            registry = display.get_registry()
            found = {}

            def on_global(registry, name, iface, ver):
                found.setdefault(iface, (name, ver))

            registry.dispatcher["global"] = on_global
            display.roundtrip()
            seat = registry.bind(found["wl_seat"][0], WlSeat, 1)
            name, ver = found["ext_idle_notifier_v1"]
            notifier = registry.bind(name, ExtIdleNotifierV1, min(ver, 2))
            # v2 ignores idle inhibitors, so a playing video does not count as presence.
            make = notifier.get_input_idle_notification if ver >= 2 else notifier.get_idle_notification
            away = make(IDLE_AFTER_MS, seat)
            away.dispatcher["idled"] = lambda *_: setattr(self, "idle", True)
            away.dispatcher["resumed"] = lambda *_: setattr(self, "idle", False)
            touch = make(1000, seat)
            touch.dispatcher["resumed"] = lambda *_: self.on_activity()
            while display.dispatch(block=True) != -1:
                pass
        except Exception:
            log.exception("idle watcher stopped")


class Remote:
    def __init__(self, cfg):
        self.cfg = cfg
        ha = cfg["ha"]
        self.url = ha["url"].rstrip("/")
        self.token = secret("token")
        self.notify_service = ha.get("notify_service")
        self.player = cfg.get("player", "Feishin")
        self.job_unit = cfg.get("job_unit", "autobuild-everything.service")
        self.allowed_app_ids = set(cfg.get("allowed_app_ids", []))
        self.locked_entity = ha.get("locked_entity", "binary_sensor.m2_locked")
        self.job_entity = ha.get("job_entity", "input_boolean.m2_autobuild")
        # entity -> (handler, cooldown seconds, reset the toggle before running)
        self.actions = {
            ha.get("lock_entity", "input_boolean.m2_lock"): (self.lock, COOLDOWN_S, False),
            ha.get("type_password_entity", "input_boolean.m2_type_password"): (self.request_password, COOLDOWN_S, False),
            ha.get("suspend_entity", "input_boolean.m2_suspend"): (self.suspend, COOLDOWN_S, True),
            ha.get("power_off_entity", "input_boolean.m2_power_off"): (self.power_off, 1, True),
            ha.get("next_track_entity", "input_boolean.m2_next_track"): (self.next_track, 1, False),
            self.job_entity: (self.start_job, COOLDOWN_S, None),
        }
        self.busy = set()
        self.last_run = {}
        self.on_since = {}
        self.armed_at = -CONFIRM_WINDOW_S
        self.job_started = 0.0
        self.job_was_active = False
        self.job_cancelled = False
        self.homekit_only = set(cfg.get("homekit_only", []))
        self.homekit_press = {}
        self.pending = None
        self.last_ask = -RESEND_AFTER_S
        self.prompt_gone_since = None
        self.denied = {}
        self.approve_button = ha.get("approve_entity", "input_button.m2_approve")
        self.deny_button = ha.get("deny_entity", "input_button.m2_deny")
        self.approver = ha.get("approver", {})
        self.was_locked_now = False
        self.screen_off = False
        self.last_level = {"screen": 70, "keyboard": 50}
        self.sent = {}
        self.session = None
        self.loop = None
        self.poll_now = asyncio.Event()
        self.idle = Idle(self.on_activity)

    def on_activity(self):
        # niri powers monitors back on at the first input.
        self.screen_off = False
        if self.loop:
            self.loop.call_soon_threadsafe(self.poll_now.set)
            if self.was_locked_now:
                self.loop.call_soon_threadsafe(lambda: asyncio.create_task(self.ask_unlock()))

    async def ask_unlock(self):
        if time.monotonic() - self.last_ask >= RESEND_AFTER_S and self.notify_service:
            await self.ask_approval(("lockscreen", 0, "unlock the screen"))

    # ---- actions (run in a worker thread)

    def lock(self):
        if noctalia_status().get("locked"):
            log.info("already locked: screen and keyboard off")
        else:
            log.info("locking")
            run("noctalia", "msg", "session", "lock")
            # Give the lock surface time to map before DPMS off.
            time.sleep(1.5)
        run("niri", "msg", "action", "power-off-monitors")
        self.screen_off = True
        kbd_off()

    def type_password(self):
        status = noctalia_status()
        app_id = focused_app_id()
        if status.get("locked"):
            target = "lockscreen"
            run("niri", "msg", "action", "power-on-monitors")
            self.screen_off = False
            time.sleep(0.5)
        elif status.get("activePanelId") == "polkit":
            target = "polkit"
        elif app_id in self.allowed_app_ids:
            if not sudo_prompting():
                return password_not_typed("No sudo prompt is waiting")
            target = app_id
        else:
            return password_not_typed(f"Focused window {app_id or 'none'} is not an allowed terminal")
        log.info("typing password into %s", target)
        # Via stdin so the password never appears in argv (/proc/*/cmdline).
        subprocess.run(["wtype", "-"], input=secret("unlock"), text=True, check=True, timeout=10)
        run("wtype", "-k", "Return")

    def request_password(self):
        if noctalia_status().get("locked"):
            prompt = ("lockscreen", 0, "unlock the screen")
        else:
            prompt = self.snapshot()["prompt"]
        if not prompt:
            return password_not_typed("Nothing is asking for a password")
        if self.pending and time.monotonic() - self.last_ask < RESEND_AFTER_S:
            return password_not_typed("An approval request is already on your phone")
        self.from_thread(self.ask_approval(prompt))

    def suspend(self):
        log.info("suspending")
        self.say_offline()
        run("systemctl", "suspend")

    def power_off(self):
        now = time.monotonic()
        if now - self.armed_at > CONFIRM_WINDOW_S:
            self.armed_at = now
            log.info("power off armed")
            self.notify("M2 power off", f"Press again within {CONFIRM_WINDOW_S} s to power off.")
            return
        log.info("powering off")
        self.say_offline()
        run("systemctl", "poweroff")

    def next_track(self):
        run("playerctl", "-p", self.player, "next")

    def job_active(self):
        return run("systemctl", "--user", "is-active", self.job_unit).stdout.strip() in ("active", "activating")

    def start_job(self):
        if self.job_active():
            return
        log.info("starting %s", self.job_unit)
        self.job_started = time.monotonic()
        self.job_was_active = True
        run("systemctl", "--user", "start", "--no-block", self.job_unit)

    def cancel_job(self):
        if not self.job_active():
            return
        log.info("cancelling %s", self.job_unit)
        self.job_cancelled = True
        run("systemctl", "--user", "stop", "--no-block", self.job_unit)

    def command(self, target, cmd, pct):
        if target == "music":
            if cmd == "level":
                run("playerctl", "-p", self.player, "volume", f"{pct / 100:.2f}")
            run("playerctl", "-p", self.player, "pause" if cmd == "off" else "play")
            return
        device = {"screen": SCREEN, "keyboard": KBD}.get(target)
        if device is None:
            return
        if cmd == "off":
            if target == "screen":
                run("niri", "msg", "action", "power-off-monitors")
                self.screen_off = True
            else:
                set_percent(device, 0)
            return
        if target == "screen":
            run("niri", "msg", "action", "power-on-monitors")
            self.screen_off = False
        if pct is not None or not percent(device):
            set_percent(device, pct or self.last_level[target])

    # ---- HA plumbing

    def from_thread(self, coro):
        return asyncio.run_coroutine_threadsafe(coro, self.loop).result(10)

    def notify(self, title, message):
        if self.notify_service:
            self.from_thread(self.service("notify", self.notify_service, {"title": title, "message": message}))

    def say_offline(self):
        try:
            self.from_thread(self.post_state("sensor.m2_last_seen", EPOCH, device_class="timestamp"))
        except Exception as e:
            log.warning("offline notice failed: %s", e)

    async def service(self, domain, name, data):
        async with self.session.post(f"{self.url}/api/services/{domain}/{name}", json=data) as r:
            r.raise_for_status()

    async def post_state(self, entity_id, state, **attributes):
        body = {"state": state, "attributes": attributes}
        if self.sent.get(entity_id) == body:
            return
        async with self.session.post(f"{self.url}/api/states/{entity_id}", json=body) as r:
            r.raise_for_status()
        self.sent[entity_id] = body

    async def set_toggle(self, entity_id, on):
        for delay in (0, 1, 3, 10):
            await asyncio.sleep(delay)
            try:
                return await self.service("input_boolean", "turn_on" if on else "turn_off", {"entity_id": entity_id})
            except (aiohttp.ClientError, asyncio.TimeoutError) as e:
                log.warning("toggle %s failed: %s", entity_id, e)

    async def call(self, entity_id):
        handler, cooldown, reset_first = self.actions[entity_id]
        if entity_id in self.busy:
            return
        self.busy.add(entity_id)
        try:
            if time.monotonic() - self.last_run.get(entity_id, -cooldown) < cooldown:
                log.warning("%s ignored: cooldown", handler.__name__)
                if handler == self.type_password:
                    await asyncio.to_thread(password_not_typed, f"Pressed again within {cooldown} s")
                return
            if entity_id in self.homekit_only:
                # HomeKit fires its event just before the service call; allow a little skew.
                await asyncio.sleep(1)
                if time.monotonic() - self.homekit_press.pop(entity_id, -60) > 5:
                    log.warning("%s refused: not pressed from Apple Home", handler.__name__)
                    if handler == self.type_password:
                        await asyncio.to_thread(password_not_typed, "Not pressed from Apple Home")
                    return
            self.last_run[entity_id] = time.monotonic()
            if reset_first:
                await self.set_toggle(entity_id, False)
            await asyncio.wait_for(asyncio.to_thread(handler), 30)
        except (Exception, SystemExit) as e:
            log.exception("%s failed", handler.__name__)
            if handler == self.type_password:
                await asyncio.to_thread(password_not_typed, f"{type(e).__name__}: {e}"[:120])
        finally:
            if reset_first is False:
                await self.set_toggle(entity_id, False)
            self.busy.discard(entity_id)
            self.poll_now.set()

    async def commands(self, queue):
        while True:
            data = await queue.get()
            try:
                pct = None
                if data.get("percentage") not in (None, "", "None"):
                    pct = max(1, round(float(data["percentage"])))
                elif data.get("brightness") not in (None, "", "None"):
                    pct = max(1, round(float(data["brightness"]) * 100 / 255))
                await asyncio.wait_for(asyncio.to_thread(self.command, data.get("target"), data.get("cmd"), pct), 15)
            except Exception:
                log.exception("command %s failed", data)
            self.poll_now.set()

    async def listen(self, queue):
        async with self.session.ws_connect(f"{self.url}/api/websocket", heartbeat=30) as ws:
            await ws.receive_json()
            await ws.send_json({"type": "auth", "access_token": self.token})
            if (await ws.receive_json()).get("type") != "auth_ok":
                raise SystemExit("HA rejected the token")
            await ws.send_json({"id": 1, "type": "subscribe_trigger",
                                "trigger": {"platform": "state", "entity_id": list(self.actions), "to": "on"}})
            await ws.send_json({"id": 2, "type": "subscribe_events", "event_type": "ha_remote_cmd"})
            await ws.send_json({"id": 3, "type": "subscribe_trigger",
                                "trigger": {"platform": "state", "entity_id": self.job_entity, "from": "on", "to": "off"}})
            await ws.send_json({"id": 4, "type": "subscribe_events", "event_type": "homekit_state_change"})
            await ws.send_json({"id": 5, "type": "subscribe_events", "event_type": "mobile_app_notification_action"})
            await ws.send_json({"id": 6, "type": "subscribe_trigger", "trigger": {
                "platform": "state", "entity_id": [self.approve_button, self.deny_button]}})
            # Left on while we were offline: clear without running.
            for entity_id in self.actions:
                if entity_id != self.job_entity:
                    await self.set_toggle(entity_id, False)
            # HA may have restarted and lost pushed states.
            self.sent.clear()
            self.poll_now.set()
            log.info("connected")
            async for msg in ws:
                if msg.type != aiohttp.WSMsgType.TEXT:
                    break
                data = json.loads(msg.data)
                if data.get("type") == "result" and not data.get("success"):
                    raise SystemExit(f"subscribe failed: {data.get('error')}")
                if data.get("type") != "event":
                    continue
                if data["id"] == 2:
                    queue.put_nowait(data["event"]["data"])
                    continue
                if data["id"] == 4:
                    hk = data["event"]["data"]
                    if hk.get("service") == "turn_on":
                        self.homekit_press[hk.get("entity_id")] = time.monotonic()
                    continue
                if data["id"] == 5:
                    if data["event"]["data"].get("action", "").startswith("M2_"):
                        asyncio.create_task(self.on_notification_action(data["event"]))
                    continue
                if data["id"] == 6:
                    trigger = data["event"]["variables"]["trigger"]
                    if trigger.get("from_state") is not None:
                        asyncio.create_task(self.on_button(trigger))
                    continue
                if data["id"] == 3:
                    # The agent only turns this off itself once the job is gone, so this is the user.
                    asyncio.create_task(asyncio.to_thread(self.cancel_job))
                    continue
                trigger = data["event"]["variables"]["trigger"]
                # from_state is None when HA restores the helper at startup, not a press.
                if trigger.get("from_state") is None:
                    continue
                if trigger["entity_id"] in self.actions:
                    asyncio.create_task(self.call(trigger["entity_id"]))

    def snapshot_prompt(self, status=None):
        status = status or noctalia_status()
        if status.get("activePanelId") == "polkit":
            pkexec = run("pgrep", "-x", "pkexec").stdout.split()
            return ("polkit", 0, cmdline(pkexec[0]).removeprefix("pkexec ") if pkexec else "a system action")
        sudo_pid = sudo_prompting()
        if sudo_pid:
            return ("sudo", sudo_pid, cmdline(sudo_pid).removeprefix("sudo ") or "sudo")
        return None

    def snapshot(self):
        status = noctalia_status()
        snap = {"locked": status.get("locked"), "prompt": self.snapshot_prompt(status), "screen": percent(SCREEN), "keyboard": percent(KBD),
                "battery": read(BATTERY / "capacity"), "battery_state": read(BATTERY / "status"),
                "plugged": read(AC / "online") == "1", "power": system_power_w(), "job": self.job_active()}
        status = run("playerctl", "-p", self.player, "status").stdout.strip()
        snap["music"] = status or "Off"
        if status:
            volume = run("playerctl", "-p", self.player, "volume").stdout.strip()
            snap["volume"] = round(float(volume) * 100) if volume else None
            meta = run("playerctl", "-p", self.player, "metadata", "--format", "{{artist}}\t{{title}}").stdout.strip()
            snap["artist"], _, snap["title"] = meta.partition("\t")
        return snap

    async def publish(self):
        s = await asyncio.to_thread(self.snapshot)
        self.was_locked_now = s["locked"]
        if not s["locked"] and self.pending and self.pending["kind"] == "lockscreen":
            await self.clear_approval()
        if not s["locked"]:
            await asyncio.to_thread(kbd_restore)
        for target in ("screen", "keyboard"):
            if s[target]:
                self.last_level[target] = s[target]
        name = self.cfg.get("device_name", "M2")
        # device_class lock: on = unlocked
        await self.post_state(self.locked_entity, "off" if s["locked"] else "on",
                              friendly_name=f"{name} locked", device_class="lock", icon="mdi:monitor-lock")
        await self.post_state("binary_sensor.m2_active", "off" if s["locked"] or self.idle.idle else "on",
                              friendly_name=f"{name} in use", device_class="occupancy")
        await self.post_state("binary_sensor.m2_plugged_in", "on" if s["plugged"] else "off",
                              friendly_name=f"{name} plugged in", device_class="plug")
        await self.post_state("sensor.m2_battery", s["battery"], friendly_name=f"{name} battery",
                              device_class="battery", unit_of_measurement="%", state_class="measurement")
        await self.post_state("sensor.m2_battery_state", s["battery_state"],
                              friendly_name=f"{name} battery state", icon="mdi:battery-charging")
        await self.post_state("sensor.m2_screen_brightness", 0 if self.screen_off else s["screen"],
                              friendly_name=f"{name} screen brightness", unit_of_measurement="%")
        await self.post_state("sensor.m2_keyboard_brightness", s["keyboard"],
                              friendly_name=f"{name} keyboard brightness", unit_of_measurement="%")
        await self.post_state("sensor.m2_music", s["music"], friendly_name=f"{name} music", icon="mdi:music",
                              volume=s.get("volume"), artist=s.get("artist"), title=s.get("title"))
        return s

    async def post_smc(self):
        for label, value in (await asyncio.to_thread(smc)).items():
            key = label.lower().replace("/", "_").replace(" ", "_").removesuffix("_temperature").removesuffix("_temp")
            if label.startswith("Fan"):
                await self.post_state(f"sensor.m2_{key}", value, friendly_name=f"M2 {label.lower()}",
                                      unit_of_measurement="RPM", icon="mdi:fan", state_class="measurement")
            elif "Temp" in label or "Hotspot" in label:
                await self.post_state(f"sensor.m2_{key}_temp", round(value / 1000, 1), friendly_name=f"M2 {label}",
                                      device_class="temperature", unit_of_measurement="°C", state_class="measurement")

    async def ask_approval(self, prompt):
        kind, pid, what = prompt
        if self.pending and self.pending["prompt"][:2] == prompt[:2]:
            # Same prompt keeps its code, so an earlier notification for it stays valid.
            nonce = self.pending["nonce"]
        else:
            nonce = secrets.token_urlsafe(16)
            self.pending = {"kind": kind, "pid": pid, "nonce": nonce, "prompt": prompt}
        self.last_ask = time.monotonic()
        log.info("asking approval for %s: %s", kind, what)
        await self.post_state("sensor.m2_request", f"{kind}: {what}"[:255], friendly_name="M2 request",
                              icon="mdi:shield-key", kind=kind, code=nonce[:4])
        await self.service("notify", self.notify_service, {
            "title": "M2 wants a password", "message": f"{kind}: {what}  [{nonce[:4]}]",
            "data": {"tag": "m2-prompt", "url": "/m2-laptop/0", "actions": [
                {"action": f"M2_APPROVE_{nonce}", "title": "Approve", "authenticationRequired": True},
                {"action": f"M2_DENY_{nonce}", "title": "Deny", "destructive": True}]}})

    async def clear_approval(self):
        self.pending = None
        await self.post_state("sensor.m2_request", "none", friendly_name="M2 request", icon="mdi:shield-key")
        await self.service("notify", self.notify_service,
                           {"message": "clear_notification", "data": {"tag": "m2-prompt"}})

    async def watch_prompts(self, prompt):
        if not self.notify_service:
            return
        if prompt:
            self.prompt_gone_since = None
            recently_denied = time.monotonic() - self.denied.get(prompt[:2], -60) < 60
            if (self.pending is None or self.pending["prompt"][:2] != prompt[:2]) and not recently_denied \
                    and self.cfg.get("notify_prompts", True):
                await self.ask_approval(prompt)
        elif self.pending and self.pending["kind"] != "lockscreen":
            self.prompt_gone_since = self.prompt_gone_since or time.monotonic()
            if time.monotonic() - self.prompt_gone_since > PROMPT_GONE_S:
                await self.clear_approval()

    def approve(self, pending):
        if pending["kind"] == "sudo" and not focus_window_of(pending["pid"]):
            return password_not_typed("Could not find the terminal window")
        self.type_password()

    def deny(self, pending):
        log.info("denying %s prompt", pending["kind"])
        if pending["kind"] == "sudo":
            os.kill(pending["pid"], signal.SIGINT)
        else:
            run("noctalia", "msg", "panel-close", "polkit")

    def sender_ok(self, context):
        sender = {"user_id": (context or {}).get("user_id")}
        if any(sender.get(k) != v for k, v in self.approver.items()):
            log.warning("ignoring approval from %s", sender)
            return False
        return True

    async def on_notification_action(self, event):
        action = event["data"].get("action", "")
        verb, _, nonce = action.rpartition("_")
        pending = self.pending
        if not pending or not secrets.compare_digest(nonce, pending["nonce"]):
            log.warning("ignoring stale notification action")
            return await asyncio.to_thread(password_not_typed, "That request is no longer current")
        if not self.sender_ok(event.get("context")):
            return await asyncio.to_thread(password_not_typed, "Approval came from an unknown user")
        await self.decide(verb, pending)

    async def on_button(self, trigger):
        if not self.sender_ok(trigger["to_state"].get("context")):
            return
        pending = self.pending
        if not pending:
            return log.warning("%s pressed with nothing pending", trigger["entity_id"])
        await self.decide("M2_APPROVE" if trigger["entity_id"] == self.approve_button else "M2_DENY", pending)

    async def decide(self, verb, pending):
        if verb == "M2_DENY":
            self.denied[pending["prompt"][:2]] = time.monotonic()
        await self.clear_approval()
        handler = {"M2_APPROVE": self.approve, "M2_DENY": self.deny}.get(verb)
        if handler:
            try:
                await asyncio.wait_for(asyncio.to_thread(handler, pending), 30)
            except Exception as e:
                log.exception("%s failed", verb)
                if verb == "M2_APPROVE":
                    await asyncio.to_thread(password_not_typed, f"{type(e).__name__}: {e}"[:120])
        self.poll_now.set()

    async def mirror_job(self, active):
        if active != self.job_was_active and time.monotonic() - self.job_started > 10:
            if self.job_was_active:
                result = (await asyncio.to_thread(run, "systemctl", "--user", "show", "-p", "Result", "--value",
                                                  self.job_unit)).stdout.strip()
                if self.job_cancelled:
                    result = "cancelled"
                self.job_cancelled = False
                log.info("%s finished: %s", self.job_unit, result)
                if self.notify_service:
                    await self.service("notify", self.notify_service,
                                       {"title": "M2 autobuild", "message": f"Finished: {result}"})
            self.job_was_active = active
        if time.monotonic() - self.job_started > 10 or active:
            async with self.session.get(f"{self.url}/api/states/{self.job_entity}") as r:
                on = r.ok and (await r.json()).get("state") == "on"
            # While stopping, leave the toggle off instead of re-asserting it.
            if on != active and not (self.job_cancelled and active):
                self.last_run[self.job_entity] = time.monotonic()
                await self.set_toggle(self.job_entity, active)

    async def unstick(self):
        now = time.monotonic()
        for entity_id in self.actions:
            if entity_id == self.job_entity:
                continue
            async with self.session.get(f"{self.url}/api/states/{entity_id}") as r:
                on = r.ok and (await r.json()).get("state") == "on"
            if not on or entity_id in self.busy:
                self.on_since.pop(entity_id, None)
            elif now - self.on_since.setdefault(entity_id, now) > STUCK_AFTER_S:
                log.warning("%s stuck on: clearing", entity_id)
                await self.set_toggle(entity_id, False)

    async def prompt_loop(self):
        while True:
            try:
                await self.watch_prompts((await asyncio.to_thread(self.snapshot_prompt)))
            except Exception as e:
                log.debug("prompt poll failed: %s", e)
            await asyncio.sleep(PROMPT_POLL_S)

    async def poll(self):
        slow = 0.0
        while True:
            try:
                s = await self.publish()
                if time.monotonic() - slow > 30:
                    slow = time.monotonic()
                    await self.post_state("sensor.m2_power", s["power"], friendly_name="M2 power draw",
                                          device_class="power", unit_of_measurement="W", state_class="measurement")
                    await self.post_smc()
                    await self.post_state("sensor.m2_last_seen",
                                          datetime.now(timezone.utc).isoformat(timespec="seconds"),
                                          friendly_name="M2 last seen", device_class="timestamp")
                await self.mirror_job(s["job"])
                await self.unstick()
            except Exception as e:
                log.debug("poll failed: %s", e)
            self.poll_now.clear()
            try:
                await asyncio.wait_for(self.poll_now.wait(), self.cfg.get("poll_interval_s", 5))
                await asyncio.sleep(0.3)
            except asyncio.TimeoutError:
                pass

    async def run_forever(self):
        self.loop = asyncio.get_running_loop()
        self.idle.start()
        headers = {"Authorization": f"Bearer {self.token}"}
        timeout = aiohttp.ClientTimeout(total=None, sock_connect=10)
        async with aiohttp.ClientSession(headers=headers, timeout=timeout) as self.session:
            queue = asyncio.Queue()
            asyncio.create_task(self.poll())
            asyncio.create_task(self.prompt_loop())
            asyncio.create_task(self.commands(queue))
            delay = 1
            while True:
                try:
                    await self.listen(queue)
                    delay = 1
                except (aiohttp.ClientError, asyncio.TimeoutError, OSError) as e:
                    log.warning("disconnected: %s", e)
                await asyncio.sleep(delay)
                delay = min(delay * 2, 60)


def main():
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")
    with open(CONFIG_PATH, "rb") as f:
        cfg = tomllib.load(f)
    asyncio.run(Remote(cfg).run_forever())


if __name__ == "__main__":
    main()

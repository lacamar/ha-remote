#!/bin/sh
set -e
cd "$(dirname "$0")"
cargo build --release
t=$PWD/target/release
pkexec sh -c "install -m755 $t/ha-remote $t/ha-remote-auth $t/ha-remote-setup /usr/bin/ \
  && install -m755 $t/pam-helper /usr/libexec/ha-remote/ \
  && systemctl restart ha-remote-auth"
systemctl --user restart ha-remote
sleep 3
journalctl -b -n 15 --no-pager -u ha-remote-auth
journalctl -b -n 15 --no-pager --user -u ha-remote

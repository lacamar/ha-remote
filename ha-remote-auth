#!/usr/bin/python3 -I
import asyncio
import json
import logging
import os
import pwd
import secrets
import signal
import socket
import struct
import sys
import time
import tomllib
from pathlib import Path

import aiohttp

log = logging.getLogger("ha-remote-auth")

CONFIG_PATH = Path("/etc/ha-remote/auth.toml")
SOCKET = Path("/run/ha-remote/auth.sock")
PAM_LINE = "auth       sufficient   pam_exec.so quiet seteuid stdout /usr/libexec/ha-remote/pam-helper"
PAM_SERVICES = ("sudo", "sudo-i", "polkit-1", "login")
PRESENT_FOR_S = 30
HOLD_MAX_S = 60


def pam_files():
    for service in PAM_SERVICES:
        path, vendor = Path("/etc/pam.d", service), Path("/usr/lib/pam.d", service)
        if path.exists() or vendor.exists():
            yield path, vendor


def enable():
    for path, vendor in pam_files():
        lines = (path if path.exists() else vendor).read_text().splitlines(keepends=True)
        if PAM_LINE + "\n" in lines:
            continue
        at = next((i for i, line in enumerate(lines) if line.split()[:1] == ["auth"]), len(lines))
        lines.insert(at, PAM_LINE + "\n")
        path.write_text("".join(lines))
        print("enabled", path)


def disable():
    for path, vendor in pam_files():
        if not path.exists() or PAM_LINE not in (text := path.read_text()):
            continue
        text = text.replace(PAM_LINE + "\n", "")
        if vendor.exists() and text == vendor.read_text():
            path.unlink()
        else:
            path.write_text(text)
        print("disabled", path)


def proc_stat(pid):
    try:
        head, rest = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)
        return head.split("(", 1)[1], int(rest.split()[1])
    except (OSError, IndexError, ValueError):
        return None, 0


def ancestors(pid):
    chain = []
    while pid > 1:
        comm, ppid = proc_stat(pid)
        if comm is None:
            break
        chain.append((pid, comm))
        pid = ppid
    return chain


def args(pid):
    try:
        return " ".join(Path(f"/proc/{pid}/cmdline").read_text().split("\0")[1:]).strip()
    except OSError:
        return ""


def pkexec_command():
    pids = (p.name for p in Path("/proc").iterdir() if p.name.isdigit())
    return next((a for pid in pids if proc_stat(pid)[0] == "pkexec" and (a := args(pid))), None)


class Auth:
    def __init__(self, cfg):
        self.url = cfg["url"].rstrip("/")
        self.token = cfg["token"]
        self.notify_service = cfg["notify_service"]
        self.approver = cfg["approver_user_id"]
        self.user = pwd.getpwnam(cfg["user"])
        self.name = cfg.get("device_name", socket.gethostname().split(".")[0])
        self.timeout = cfg.get("timeout_s", 60)
        self.active, self.active_at, self.hold_until = True, 0.0, 0.0
        self.waiting = {}
        self.connected = False
        self.session = None

    def present(self):
        now = time.monotonic()
        return now >= self.hold_until and (self.active or now - self.active_at < PRESENT_FOR_S)

    def describe(self, pid, uid, req):
        if req.get("user") != self.user.pw_name or req.get("rhost"):
            return None
        chain = ancestors(pid)
        comms = [comm for _, comm in chain]
        if any(comm.startswith("sshd") for comm in comms):
            return None
        service = req.get("service")
        if uid == 0 and service in ("sudo", "sudo-i"):
            sudo = next((p for p, comm in chain if comm == "sudo"), None)
            return sudo and ("sudo", (args(sudo) or "a shell")[:120], sudo)
        if uid == 0 and service == "polkit-1":
            return "polkit", (pkexec_command() or "a system action")[:120], None
        if uid == self.user.pw_uid and service == "login" and "noctalia" in comms:
            return "lockscreen", "unlock the screen", None
        return None

    async def service(self, domain, name, data):
        async with self.session.post(f"{self.url}/api/services/{domain}/{name}", json=data,
                                     timeout=aiohttp.ClientTimeout(total=10)) as r:
            r.raise_for_status()

    async def authorize(self, pid, uid, req, reader, writer):
        prompt = self.describe(pid, uid, req)
        if not prompt or not self.connected:
            return False
        kind, what, sudo_pid = prompt
        # Someone just typed the password into the lock screen.
        if kind == "lockscreen" and self.present():
            return False
        writer.write(b'{"asking": true}\n')
        await writer.drain()
        nonce = secrets.token_hex(16)
        verdict = asyncio.get_running_loop().create_future()
        self.waiting[nonce] = verdict
        tag = f"ha-remote-{nonce[:8]}"
        gone = asyncio.ensure_future(reader.read(1))
        log.info("asking approval for %s: %s", kind, what)
        try:
            await self.service("notify", self.notify_service, {
                "title": f"{self.name}: {kind}", "message": what, "data": {"tag": tag, "actions": [
                    {"action": f"HAREMOTE_APPROVE_{nonce}", "title": "Approve", "authenticationRequired": True},
                    {"action": f"HAREMOTE_DENY_{nonce}", "title": "Deny", "destructive": True}]}})
            await asyncio.wait({verdict, gone}, timeout=self.timeout, return_when=asyncio.FIRST_COMPLETED)
        except (aiohttp.ClientError, asyncio.TimeoutError) as e:
            log.warning("notify failed: %s", e)
        finally:
            gone.cancel()
            del self.waiting[nonce]
            try:
                await self.service("notify", self.notify_service, {"message": "clear_notification", "data": {"tag": tag}})
            except (aiohttp.ClientError, asyncio.TimeoutError):
                pass
        decided = verdict.done() and not verdict.cancelled()
        approved = decided and verdict.result()
        log.info("%s %s", kind, "approved" if approved else "denied" if decided else "not approved")
        if decided and not approved and sudo_pid:
            os.kill(sudo_pid, signal.SIGINT)
        return approved

    def abandon(self):
        for verdict in self.waiting.values():
            verdict.cancel()

    async def handle(self, reader, writer):
        pid, uid, _ = struct.unpack("3i", writer.get_extra_info("socket").getsockopt(
            socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))
        owner = uid == self.user.pw_uid
        presence = False
        try:
            if uid != 0 and not owner:
                return
            async for line in reader:
                req = json.loads(line)
                if req.get("type") == "presence" and owner:
                    presence = True
                    self.active, self.active_at = bool(req.get("active")), time.monotonic()
                    if self.active and time.monotonic() >= self.hold_until:
                        # Input at the laptop: drop phone requests so the password prompt shows.
                        self.abandon()
                elif req.get("type") == "hold" and owner:
                    self.hold_until = time.monotonic() + min(float(req.get("s", 0)), HOLD_MAX_S)
                elif req.get("type") == "auth":
                    ok = await self.authorize(pid, uid, req, reader, writer)
                    writer.write(json.dumps({"ok": ok}).encode() + b"\n")
                    await writer.drain()
                    return
        except (ValueError, OSError) as e:
            log.warning("client %s: %s", pid, e)
        finally:
            if presence:
                self.active = True
            writer.close()

    def on_action(self, event):
        verb, _, nonce = event["data"].get("action", "").rpartition("_")
        verdict = self.waiting.get(nonce)
        if verdict is None or verdict.done() or verb not in ("HAREMOTE_APPROVE", "HAREMOTE_DENY"):
            return
        user_id = (event.get("context") or {}).get("user_id")
        if user_id != self.approver:
            return log.warning("ignoring %s from user %s", verb, user_id)
        verdict.set_result(verb == "HAREMOTE_APPROVE")

    async def listen(self):
        async with self.session.ws_connect(f"{self.url}/api/websocket", heartbeat=30) as ws:
            await ws.receive_json()
            await ws.send_json({"type": "auth", "access_token": self.token})
            if (await ws.receive_json()).get("type") != "auth_ok":
                raise SystemExit("HA rejected the token")
            await ws.send_json({"id": 1, "type": "auth/current_user"})
            if (await ws.receive_json())["result"]["id"] == self.approver:
                raise SystemExit("token belongs to the approver; use a token of a separate HA user")
            await ws.send_json({"id": 2, "type": "subscribe_events", "event_type": "mobile_app_notification_action"})
            if not (await ws.receive_json()).get("success"):
                raise SystemExit("subscribe failed")
            self.connected = True
            log.info("connected")
            try:
                async for msg in ws:
                    if msg.type != aiohttp.WSMsgType.TEXT:
                        break
                    data = json.loads(msg.data)
                    if data.get("type") == "event":
                        self.on_action(data["event"])
            finally:
                self.connected = False

    async def run(self):
        SOCKET.unlink(missing_ok=True)
        await asyncio.start_unix_server(self.handle, SOCKET)
        SOCKET.chmod(0o666)
        headers = {"Authorization": f"Bearer {self.token}"}
        async with aiohttp.ClientSession(headers=headers, timeout=aiohttp.ClientTimeout(total=None, sock_connect=10)) as self.session:
            delay = 1
            while True:
                try:
                    await self.listen()
                    delay = 1
                except (aiohttp.ClientError, asyncio.TimeoutError, OSError) as e:
                    log.warning("disconnected: %s", e)
                await asyncio.sleep(delay)
                delay = min(delay * 2, 60)


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else "run"
    if command in ("enable", "disable"):
        return (enable if command == "enable" else disable)()
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")
    if CONFIG_PATH.stat().st_mode & 0o077:
        raise SystemExit(f"{CONFIG_PATH} holds a token: chmod 600 it")
    with open(CONFIG_PATH, "rb") as f:
        cfg = tomllib.load(f)
    asyncio.run(Auth(cfg).run())


if __name__ == "__main__":
    main()

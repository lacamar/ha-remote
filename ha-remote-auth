#!/usr/bin/python3 -I
import asyncio
import fcntl
import json
import logging
import os
import pwd
import secrets
import signal
import socket
import struct
import sys
import termios
import time
import tomllib
from pathlib import Path

import aiohttp

log = logging.getLogger("ha-remote-auth")

CONFIG_PATH = Path("/etc/ha-remote/auth.toml")
SOCKET = Path("/run/ha-remote/auth.sock")
HELPER = "/usr/libexec/ha-remote/pam-helper"
PAM_SERVICES = ("sudo", "sudo-i", "polkit-1", "login")
HOLD_MAX_S = 60


def pam_files():
    for service in PAM_SERVICES:
        path, vendor = Path("/etc/pam.d", service), Path("/usr/lib/pam.d", service)
        if path.exists() or vendor.exists():
            yield path, vendor


def pam_lines(service):
    finish = f"auth       sufficient   pam_exec.so quiet seteuid expose_authtok {HELPER} finish\n"
    # The lock screen only runs PAM after a submit, so there is nothing to start early.
    if service == "login":
        return [finish]
    # noctalia's polkit panel does not make room for an info line.
    options = "seteuid stdout" if service.startswith("sudo") else "seteuid"
    # polkit's start can answer for the phone while the screen is locked.
    control = "sufficient" if service == "polkit-1" else "optional"
    return [f"auth       {control:<13}pam_exec.so quiet {options} {HELPER} start\n", finish]


def enable():
    for path, vendor in pam_files():
        lines = (path if path.exists() else vendor).read_text().splitlines(keepends=True)
        wanted = pam_lines(path.name)
        at = next((i for i, l in enumerate(lines) if l.split()[:1] == ["auth"]), len(lines))
        if lines[at:at + len(wanted)] == wanted:
            continue
        lines = [l for l in lines if HELPER not in l]
        at = next((i for i, l in enumerate(lines) if l.split()[:1] == ["auth"]), len(lines))
        lines[at:at] = wanted
        path.write_text("".join(lines))
        print("enabled", path)


def disable():
    for path, vendor in pam_files():
        if not path.exists() or HELPER not in (text := path.read_text()):
            continue
        text = "".join(l for l in text.splitlines(keepends=True) if HELPER not in l)
        if vendor.exists() and text == vendor.read_text():
            path.unlink()
        else:
            path.write_text(text)
        print("disabled", path)


def proc_stat(pid):
    try:
        head, rest = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)
        fields = rest.split()
        return head.split("(", 1)[1], int(fields[1]), int(fields[4])
    except (OSError, IndexError, ValueError):
        return None, 0, 0


def ancestors(pid):
    chain = []
    while pid > 1:
        comm, ppid, _ = proc_stat(pid)
        if comm is None:
            break
        chain.append((pid, comm))
        pid = ppid
    return chain


def args(pid):
    try:
        return " ".join(Path(f"/proc/{pid}/cmdline").read_text().split("\0")[1:]).strip()
    except OSError:
        return ""


def pkexec_commands():
    pids = (p.name for p in Path("/proc").iterdir() if p.name.isdigit())
    return " or ".join(a for pid in pids if proc_stat(pid)[0] == "pkexec" and (a := args(pid)))


def tty_of(pid):
    nr = proc_stat(pid)[2]
    major, minor = (nr >> 8) & 0xFFF, (nr & 0xFF) | ((nr >> 12) & 0xFFF00)
    if major == 136:
        return f"/dev/pts/{minor}"
    if major == 4 and 0 < minor < 64:
        return f"/dev/tty{minor}"
    return None


def press_enter(tty):
    fd = os.open(tty, os.O_RDWR | os.O_NOCTTY)
    try:
        fcntl.ioctl(fd, termios.TIOCSTI, b"\n")
    finally:
        os.close(fd)


class Request:
    def __init__(self, kind, what, app):
        self.kind, self.what, self.app = kind, what, app
        self.tty = tty_of(app) if kind in ("sudo", "polkit") else None
        self.nonce = secrets.token_hex(16)
        self.verdict = asyncio.get_running_loop().create_future()
        self.blocking = False


class Auth:
    def __init__(self, cfg):
        self.url = cfg["url"].rstrip("/")
        self.token = cfg["token"]
        self.notify_service = cfg["notify_service"]
        self.approver = cfg["approver_user_id"]
        self.user = pwd.getpwnam(cfg["user"])
        self.name = cfg.get("device_name", socket.gethostname().split(".")[0])
        self.timeout = cfg.get("timeout_s", 60)
        self.hold_until = 0.0
        self.requests = {}
        self.agent = None
        self.locked = False
        self.connected = False
        self.session = None

    def describe(self, pid, uid, req):
        if req.get("user") != self.user.pw_name or req.get("rhost"):
            return None
        chain = ancestors(pid)
        comms = [comm for _, comm in chain]
        if len(chain) < 2 or any(comm.startswith("sshd") for comm in comms):
            return None
        app, app_comm = chain[1]
        service = req.get("service")
        if uid == 0 and service in ("sudo", "sudo-i") and app_comm == "sudo":
            return "sudo", (args(app) or "a shell")[:120], app
        if uid == 0 and service == "polkit-1":
            caller = next((f"{comm} {args(pid)}" for (_, child), (pid, comm) in zip(chain, chain[1:]) if child == "pkttyagent"), None)
            return "polkit", (pkexec_commands() or caller or "a system action")[:120], app
        if uid == self.user.pw_uid and service == "login" and "noctalia" in comms:
            return "lockscreen", "unlock the screen", app
        return None

    async def service(self, domain, name, data):
        async with self.session.post(f"{self.url}/api/services/{domain}/{name}", json=data,
                                     timeout=aiohttp.ClientTimeout(total=10)) as r:
            r.raise_for_status()

    def tag(self, request):
        return f"ha-remote-{request.nonce[:8]}"

    async def ask(self, kind, what, app):
        request = self.requests[app] = Request(kind, what, app)
        log.info("asking approval for %s: %s", kind, what)
        try:
            await self.service("notify", self.notify_service, {
                "title": f"{self.name}: {kind}", "message": what, "data": {"tag": self.tag(request), "actions": [
                    {"action": f"HAREMOTE_APPROVE_{request.nonce}", "title": "Approve", "authenticationRequired": True},
                    {"action": f"HAREMOTE_DENY_{request.nonce}", "title": "Deny", "destructive": True}]}})
        except (aiohttp.ClientError, asyncio.TimeoutError) as e:
            log.warning("notify failed: %s", e)
            await self.drop(request)
            return None
        asyncio.create_task(self.expire(request))
        return request

    async def drop(self, request):
        if self.requests.get(request.app) is not request:
            return
        del self.requests[request.app]
        if not request.verdict.done():
            request.verdict.cancel()
        try:
            await self.service("notify", self.notify_service, {"message": "clear_notification", "data": {"tag": self.tag(request)}})
        except (aiohttp.ClientError, asyncio.TimeoutError):
            pass

    async def expire(self, request):
        deadline = time.monotonic() + self.timeout
        while self.requests.get(request.app) is request and time.monotonic() < deadline:
            if proc_stat(request.app)[0] is None:
                break
            await asyncio.sleep(1)
        await self.drop(request)

    def approved(self, request):
        return request.verdict.done() and not request.verdict.cancelled() and request.verdict.result()

    async def start(self, pid, uid, req, reader, writer):
        prompt = self.describe(pid, uid, req)
        if not prompt or not self.connected:
            return False
        kind, what, app = prompt
        if not (request := self.requests.get(app) or await self.ask(kind, what, app)):
            return False
        writer.write(b'{"asking": true}\n')
        # The lock screen covers the polkit panel, so nothing could submit it.
        if kind == "polkit" and self.locked:
            await writer.drain()
            return await self.wait(request, reader)
        return False

    async def finish(self, pid, uid, req, reader, writer):
        prompt = self.describe(pid, uid, req)
        if not prompt:
            return False
        kind, what, app = prompt
        request = self.requests.get(app)
        if request and (self.approved(request) or req.get("typed")):
            await self.drop(request)
            return self.approved(request)
        if req.get("typed") or not self.connected:
            return False
        # Submitted empty: wait here for the phone.
        if not request:
            if not (request := await self.ask(kind, what, app)):
                return False
            writer.write(b'{"asking": true}\n')
            await writer.drain()
        return await self.wait(request, reader)

    async def wait(self, request, reader):
        request.blocking = True
        gone = asyncio.ensure_future(reader.read(1))
        await asyncio.wait({request.verdict, gone}, return_when=asyncio.FIRST_COMPLETED)
        gone.cancel()
        await self.drop(request)
        self.log_verdict(request)
        return self.approved(request)

    def log_verdict(self, request):
        decided = request.verdict.done() and not request.verdict.cancelled()
        log.info("%s %s", request.kind, ("approved" if request.verdict.result() else "denied") if decided else "not approved")

    def submit(self, request):
        # Answer the open password prompt; finish sees the verdict.
        self.log_verdict(request)
        if request.blocking or proc_stat(request.app)[0] is None:
            return
        approved = self.approved(request)
        if request.kind == "sudo" or request.tty:
            if approved and request.tty:
                press_enter(request.tty)
            elif not approved:
                os.kill(request.app, signal.SIGINT)
        elif request.kind == "polkit" and self.agent:
            self.agent.write(json.dumps({"type": "polkit", "submit": approved}).encode() + b"\n")
        elif request.kind == "lockscreen" and approved and self.agent:
            self.agent.write(b'{"type": "unlock"}\n')

    async def ask_lockscreen(self):
        uid = self.user.pw_uid
        app = next((int(p.name) for p in Path("/proc").iterdir()
                    if p.name.isdigit() and proc_stat(p.name)[0] == "noctalia" and p.stat().st_uid == uid), None)
        if app and app not in self.requests and self.connected and time.monotonic() >= self.hold_until:
            await self.ask("lockscreen", "unlock the screen", app)

    def abandon(self):
        for request in self.requests.values():
            if request.blocking and not request.verdict.done():
                request.verdict.cancel()

    async def handle(self, reader, writer):
        pid, uid, _ = struct.unpack("3i", writer.get_extra_info("socket").getsockopt(
            socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))
        owner = uid == self.user.pw_uid
        try:
            if uid != 0 and not owner:
                return
            async for line in reader:
                req = json.loads(line)
                if req.get("type") == "presence" and owner:
                    self.agent = writer
                    if req.get("active") and time.monotonic() >= self.hold_until:
                        # Input at the laptop: drop a blocking phone wait so the password prompt returns.
                        self.abandon()
                elif req.get("type") == "lockscreen" and owner:
                    asyncio.create_task(self.ask_lockscreen())
                elif req.get("type") == "locked" and owner:
                    self.locked = bool(req.get("locked"))
                elif req.get("type") == "hold" and owner:
                    self.hold_until = time.monotonic() + min(float(req.get("s", 0)), HOLD_MAX_S)
                elif req.get("type") == "auth":
                    if req.get("stage") == "start":
                        ok = await self.start(pid, uid, req, reader, writer)
                    else:
                        ok = await self.finish(pid, uid, req, reader, writer)
                    writer.write(json.dumps({"ok": ok}).encode() + b"\n")
                    await writer.drain()
                    return
        except (ValueError, OSError) as e:
            log.warning("client %s: %s", pid, e)
        finally:
            if self.agent is writer:
                self.agent = None
                self.locked = False
            writer.close()

    def on_action(self, event):
        verb, _, nonce = event["data"].get("action", "").rpartition("_")
        request = next((r for r in self.requests.values() if secrets.compare_digest(r.nonce, nonce)), None)
        if request is None or request.verdict.done() or verb not in ("HAREMOTE_APPROVE", "HAREMOTE_DENY"):
            return
        user_id = (event.get("context") or {}).get("user_id")
        if user_id != self.approver:
            return log.warning("ignoring %s from user %s", verb, user_id)
        request.verdict.set_result(verb == "HAREMOTE_APPROVE")
        self.submit(request)

    async def listen(self):
        async with self.session.ws_connect(f"{self.url}/api/websocket", heartbeat=30) as ws:
            await ws.receive_json()
            await ws.send_json({"type": "auth", "access_token": self.token})
            if (await ws.receive_json()).get("type") != "auth_ok":
                raise SystemExit("HA rejected the token")
            await ws.send_json({"id": 1, "type": "auth/current_user"})
            if (await ws.receive_json())["result"]["id"] == self.approver:
                raise SystemExit("token belongs to the approver; use a token of a separate HA user")
            await ws.send_json({"id": 2, "type": "subscribe_events", "event_type": "mobile_app_notification_action"})
            if not (await ws.receive_json()).get("success"):
                raise SystemExit("subscribe failed")
            self.connected = True
            log.info("connected")
            try:
                async for msg in ws:
                    if msg.type != aiohttp.WSMsgType.TEXT:
                        break
                    data = json.loads(msg.data)
                    if data.get("type") == "event":
                        self.on_action(data["event"])
            finally:
                self.connected = False

    async def run(self):
        SOCKET.unlink(missing_ok=True)
        await asyncio.start_unix_server(self.handle, SOCKET)
        SOCKET.chmod(0o666)
        headers = {"Authorization": f"Bearer {self.token}"}
        async with aiohttp.ClientSession(headers=headers, timeout=aiohttp.ClientTimeout(total=None, sock_connect=10)) as self.session:
            delay = 1
            while True:
                try:
                    await self.listen()
                    delay = 1
                except (aiohttp.ClientError, asyncio.TimeoutError, OSError) as e:
                    log.warning("disconnected: %s", e)
                await asyncio.sleep(delay)
                delay = min(delay * 2, 60)


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else "run"
    if command in ("enable", "disable"):
        return (enable if command == "enable" else disable)()
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")
    if CONFIG_PATH.stat().st_mode & 0o077:
        raise SystemExit(f"{CONFIG_PATH} holds a token: chmod 600 it")
    with open(CONFIG_PATH, "rb") as f:
        cfg = tomllib.load(f)
    asyncio.run(Auth(cfg).run())


if __name__ == "__main__":
    main()

#!/usr/bin/python3
import asyncio
import json
import os
import subprocess
import tomllib
import urllib.error
import urllib.request
from pathlib import Path

import aiohttp

CONFIG_PATH = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "ha-remote" / "config.toml"
HA = tomllib.loads(CONFIG_PATH.read_text())["ha"]
URL = HA["url"].rstrip("/")
TOKEN = subprocess.run(["secret-tool", "lookup", "service", "ha-remote", "key", "token"],
                       capture_output=True, text=True, check=True).stdout.strip()

TOGGLES = {"Lock": "mdi:lock", "Type password": "mdi:form-textbox-password", "Suspend": "mdi:power-sleep",
           "Power off": "mdi:power", "Next track": "mdi:skip-next", "Autobuild": "mdi:package-variant-closed"}


def call(method, path, body=None):
    req = urllib.request.Request(URL + path, None if body is None else json.dumps(body).encode(),
                                 {"Authorization": f"Bearer {TOKEN}", "Content-Type": "application/json"},
                                 method=method)
    try:
        raw = urllib.request.urlopen(req, timeout=30).read()
        return json.loads(raw) if raw else None
    except urllib.error.HTTPError as e:
        return {"type": f"HTTP {e.code}", "errors": e.read().decode()[:300]}


def flow(handler, *steps):
    result = call("POST", "/api/config/config_entries/flow", {"handler": handler})
    for step in steps:
        result = call("POST", f"/api/config/config_entries/flow/{result['flow_id']}", step)
    return result


async def ws_send(commands):
    async with aiohttp.ClientSession() as session, session.ws_connect(f"{URL}/api/websocket") as ws:
        await ws.receive_json()
        await ws.send_json({"type": "auth", "access_token": TOKEN})
        await ws.receive_json()
        results = []
        for i, command in enumerate(commands, 1):
            await ws.send_json({"id": i, **command})
            results.append(await ws.receive_json())
        return results


def template(kind, data):
    if call("GET", f"/api/states/{kind}.{data['name'].lower().replace(' ', '_')}").get("entity_id"):
        return print("exists", data["name"])
    result = flow("template", {"next_step_id": kind}, data)
    print(kind, data["name"], result.get("type"), result.get("errors") or "")


def event(target, cmd, key=None):
    data = {"target": target, "cmd": cmd}
    if key:
        data[key] = "{{ %s }}" % key
    return [{"event": "ha_remote_cmd", "event_data": data}]


def main():
    create = []
    for name, icon in TOGGLES.items():
        entity = f"input_boolean.m2_{name.lower().replace(' ', '_')}"
        if call("GET", f"/api/states/{entity}").get("entity_id"):
            print("exists", entity)
        else:
            # Named "M2 x" so the entity id gets the prefix; shorten the name in the UI afterwards.
            create.append({"type": "input_boolean/create", "name": f"M2 {name}", "icon": icon})
    for command, result in zip(create, asyncio.run(ws_send(create)) if create else []):
        print(command["name"], result.get("success"))

    buttons = [{"type": "input_button/create", "name": f"M2 {n}", "icon": i}
               for n, i in (("Approve", "mdi:check-bold"), ("Deny", "mdi:close-thick"))
               if not call("GET", f"/api/states/input_button.m2_{n.lower()}").get("entity_id")]
    for command, result in zip(buttons, asyncio.run(ws_send(buttons)) if buttons else []):
        print(command["name"], result.get("success"))
    dashboards = asyncio.run(ws_send([{"type": "lovelace/dashboards/list"}]))[0]["result"]
    if not any(d.get("url_path") == "m2-laptop" for d in dashboards):
        asyncio.run(ws_send([{"type": "lovelace/dashboards/create", "url_path": "m2-laptop", "title": "M2",
                              "icon": "mdi:laptop", "show_in_sidebar": True, "require_admin": False}]))
    press = lambda e: {"action": "call-service", "service": "input_button.press", "target": {"entity_id": e}}
    view = {"title": "M2", "path": "0", "cards": [
        {"type": "entities", "title": "Password request", "entities": [{"entity": "sensor.m2_request", "name": "Waiting for"}]},
        {"type": "horizontal-stack", "cards": [
            {"type": "button", "entity": "input_button.m2_approve", "name": "Approve", "tap_action": press("input_button.m2_approve")},
            {"type": "button", "entity": "input_button.m2_deny", "name": "Deny", "tap_action": press("input_button.m2_deny")}]},
        {"type": "entities", "title": "Controls", "entities": [
            "input_boolean.m2_lock", "input_boolean.m2_type_password", "input_boolean.m2_suspend", "input_boolean.m2_power_off",
            "input_boolean.m2_next_track", "input_boolean.m2_autobuild", "light.m2_screen", "light.m2_keyboard", "fan.m2_music"]},
        {"type": "entities", "title": "Status", "entities": [
            "binary_sensor.m2_online", "binary_sensor.m2_locked", "binary_sensor.m2_active", "sensor.m2_battery",
            "sensor.m2_battery_state", "binary_sensor.m2_plugged_in", "sensor.m2_power", "sensor.m2_fan_1", "sensor.m2_fan_2",
            "sensor.m2_music"]}]}
    print("dashboard", asyncio.run(ws_send([{"type": "lovelace/config/save", "url_path": "m2-laptop",
                                             "config": {"views": [view]}}]))[0].get("success"))

    for target in ("screen", "keyboard"):
        sensor = f"sensor.m2_{target}_brightness"
        template("light", {"name": f"M2 {target.capitalize()}",
                           "state": "{{ states('%s')|float(0) > 0 }}" % sensor,
                           "level": "{{ (states('%s')|float(0) * 2.55)|round }}" % sensor,
                           "turn_on": event(target, "on"), "turn_off": event(target, "off"),
                           "set_level": event(target, "level", "brightness")})
    template("fan", {"name": "M2 Music", "speed_count": 100,
                     "state": "{{ is_state('sensor.m2_music','Playing') }}",
                     "percentage": "{{ state_attr('sensor.m2_music','volume')|int(0) }}",
                     "turn_on": event("music", "on"), "turn_off": event("music", "off"),
                     "set_percentage": event("music", "level", "percentage")})
    template("binary_sensor", {"name": "M2 online", "device_class": "connectivity",
                               "state": "{{ as_timestamp(now()) - as_timestamp(states('sensor.m2_last_seen'), 0) < 120 }}"})

    online = {"condition": "state", "entity_id": "binary_sensor.m2_online", "state": "on"}
    person = HA.get("person", "person.me")
    notify = f"notify.{HA['notify_service']}"
    automations = {
        "m2_lock_on_leave": {
            "alias": "M2: lock when I leave home", "mode": "single",
            "triggers": [{"trigger": "state", "entity_id": person, "from": "home"}],
            # device_class lock: on = unlocked
            "conditions": [online, {"condition": "state", "entity_id": "binary_sensor.m2_locked", "state": "on"}],
            "actions": [{"action": "input_boolean.turn_on", "target": {"entity_id": "input_boolean.m2_lock"}}]},
        "m2_unlock_prompt_on_arrive": {
            "alias": "M2: remind me it is locked when I arrive home", "mode": "single",
            "triggers": [{"trigger": "state", "entity_id": person, "to": "home"}],
            "conditions": [online, {"condition": "state", "entity_id": "binary_sensor.m2_locked", "state": "off"}],
            "actions": [{"action": notify, "data": {
                "title": "Welcome home", "message": "M2 is locked. Unlock it from Apple Home."}}]},
        "m2_desk_idle_plug_off": {
            "alias": "M2: desk idle turns off the desk plug", "mode": "restart",
            "triggers": [{"trigger": "state", "entity_id": "binary_sensor.m2_active", "to": "off", "for": {"minutes": 10}},
                         {"trigger": "state", "entity_id": "binary_sensor.m2_online", "to": "off", "for": {"minutes": 10}}],
            "conditions": [{"condition": "state", "entity_id": HA.get("desk_switch", "switch.desk"), "state": "on"}],
            "actions": [{"action": "switch.turn_off", "target": {"entity_id": HA.get("desk_switch", "switch.desk")}}]},
    }
    for key, config in automations.items():
        print(key, call("POST", f"/api/config/automation/config/{key}", config))


if __name__ == "__main__":
    main()

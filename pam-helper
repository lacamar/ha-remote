#!/usr/bin/python3 -I
import json
import os
import socket
import sys

try:
    with socket.socket(socket.AF_UNIX) as s:
        s.settimeout(300)
        s.connect("/run/ha-remote/auth.sock")
        s.sendall(json.dumps({"type": "auth", "service": os.environ.get("PAM_SERVICE"), "user": os.environ.get("PAM_USER"),
                              "rhost": os.environ.get("PAM_RHOST", "")}).encode() + b"\n")
        for line in s.makefile():
            reply = json.loads(line)
            if reply.get("asking"):
                print("Approve on your phone, or wait for the password prompt.", flush=True)
            elif "ok" in reply:
                sys.exit(0 if reply["ok"] else 1)
except (OSError, ValueError):
    pass
sys.exit(1)

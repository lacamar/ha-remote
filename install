#!/usr/bin/bash
set -euo pipefail
here=$(dirname "$(readlink -f "$0")")
config=${XDG_CONFIG_HOME:-$HOME/.config}
protocols=${XDG_DATA_HOME:-$HOME/.local/share}/ha-remote/protocols/hrproto

mkdir -p "$HOME/.local/bin" "$config/ha-remote" "$config/systemd/user" "$protocols"
ln -sf "$here/ha-remote" "$HOME/.local/bin/ha-remote"
ln -sf "$here/ha-remote.service" "$config/systemd/user/ha-remote.service"
[[ -e $config/ha-remote/config.toml ]] || cp "$here/config.example.toml" "$config/ha-remote/config.toml"

touch "$protocols/__init__.py"
python3 -m pywayland.scanner -o "$protocols" -i /usr/share/wayland/wayland.xml \
    /usr/share/wayland-protocols/staging/ext-idle-notify/ext-idle-notify-v1.xml

systemctl --user daemon-reload
systemctl --user enable ha-remote.service
